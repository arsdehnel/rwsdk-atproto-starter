{
	// Schema reference for wrangler configuration
	"$schema": "node_modules/wrangler/config-schema.json",

	// Name of your worker
	"name": "rwsdk-atproto-starter",

	// Entry point for your worker
	"main": "src/worker.tsx",

	// Compatibility settings
	"compatibility_date": "2025-08-21",
	"compatibility_flags": ["nodejs_compat"],

	// Assets configuration
	"assets": {
		"binding": "ASSETS"
	},

	// Observability settings
	"observability": {
		"enabled": true
	},

	// KV for AT Protocol OAuth state
	"kv_namespaces": [
		{ "binding": "KV_OAUTH_STATE", "id": "KV_OAUTH_STATE_LOCAL" }
	],

	// D1 for persisting status records indexed from the Tap webhook.
	// For production: run `wrangler d1 create rwsdk-atproto-starter` and replace database_id.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "rwsdk-atproto-starter-local",
			"database_id": "local",
			"migrations_dir": "drizzle"
		}
	],

	// Durable Objects for browser sessions, TAP sync state, and OAuth tokens
	"durable_objects": {
		"bindings": [
			{
				"name": "DO_BROWSER_SESSION",
				"class_name": "BrowserSession"
			},
			{
				"name": "DO_APPVIEW_SYNC_STATE",
				"class_name": "AppViewSyncState"
			},
			{
				"name": "DO_OAUTH_TOKEN",
				"class_name": "OAuthToken"
			}
		]
	},

	// Declarative export registration for Durable Object classes.
	// Mutually exclusive with the older "migrations" array.
	"exports": {
		"BrowserSession": { "type": "durable-object", "storage": "sqlite" },
		"AppViewSyncState": { "type": "durable-object", "storage": "sqlite" },
		"OAuthToken": { "type": "durable-object", "storage": "sqlite" }
	},

	"secrets": {
		"required": [
			"BROWSER_SESSION_SIGNING_KEY",
			"OAUTH_STATE_KV_ENCRYPTION_KEYS",
			"OAUTH_TOKEN_KV_ENCRYPTION_KEYS",
			"WEBHOOK_TAP_SECRET"
		]
	},

	// Environment variables — local dev only.
	// ATPROTO_* vars are absent in deployed environments so the app falls back
	// to production AT Protocol infrastructure (bsky.social, plc.directory).
	"vars": {
		"ATPROTO_PDS_URL": "http://localhost:3000",
		"ATPROTO_PLC_URL": "http://localhost:2582"
	},
	"env": {
		"integration": {
			"vars": {
				"APP_URL": "https://rwsdk-atproto-starter-integration.example.workers.dev"
			},
			"kv_namespaces": [
				{ "binding": "KV_OAUTH_STATE", "id": "<integration-kv-namespace-id>" }
			],
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "rwsdk-atproto-starter-integration",
					"database_id": "<integration-d1-database-id>",
					"migrations_dir": "drizzle"
				}
			],
			"durable_objects": {
				"bindings": [
					{ "name": "DO_BROWSER_SESSION", "class_name": "BrowserSession" },
					{ "name": "DO_APPVIEW_SYNC_STATE", "class_name": "AppViewSyncState" },
					{ "name": "DO_OAUTH_TOKEN", "class_name": "OAuthToken" }
				]
			}
		},
		"staging": {
			"vars": {
				"APP_URL": "https://rwsdk-atproto-starter-staging.example.workers.dev"
			},
			"kv_namespaces": [
				{ "binding": "KV_OAUTH_STATE", "id": "<staging-kv-namespace-id>" }
			],
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "rwsdk-atproto-starter-staging",
					"database_id": "<staging-d1-database-id>",
					"migrations_dir": "drizzle"
				}
			],
			"durable_objects": {
				"bindings": [
					{ "name": "DO_BROWSER_SESSION", "class_name": "BrowserSession" },
					{ "name": "DO_APPVIEW_SYNC_STATE", "class_name": "AppViewSyncState" },
					{ "name": "DO_OAUTH_TOKEN", "class_name": "OAuthToken" }
				]
			}
		},
		"production": {
			"vars": {
				"APP_URL": "https://rwsdk-atproto-starter-production.example.workers.dev"
			},
			"kv_namespaces": [
				{ "binding": "KV_OAUTH_STATE", "id": "<production-kv-namespace-id>" }
			],
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "rwsdk-atproto-starter-production",
					"database_id": "<production-d1-database-id>",
					"migrations_dir": "drizzle"
				}
			],
			"durable_objects": {
				"bindings": [
					{ "name": "DO_BROWSER_SESSION", "class_name": "BrowserSession" },
					{ "name": "DO_APPVIEW_SYNC_STATE", "class_name": "AppViewSyncState" },
					{ "name": "DO_OAUTH_TOKEN", "class_name": "OAuthToken" }
				]
			}
		}
	}
}
